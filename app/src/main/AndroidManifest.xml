<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground shift service (keeps recording alive through doze).
         Use dataSync — not location — because this service runs in the plugin
         process, which has no ACCESS_*_LOCATION grant (ATAK host holds those).
         Android 14+ rejects FGS type=location without that runtime permission
         and sticky-restarts crash-loop the plugin package. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Bluetooth plow/spreader controllers (optional EquipmentProvider) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_plowtak"
        android:label="@string/app_name"
        android:description="@string/app_desc"
        android:theme="@style/ATAKPluginTheme">

        <!-- ATAK plugin contract: host API version this plugin was built against -->
        <meta-data
            android:name="plugin-api"
            android:value="${atakApiVersion}" />

        <meta-data
            android:name="app_desc"
            android:value="@string/app_desc" />

        <!-- Required for ATAK 4.6.0.2+ plugin discovery. Without this activity,
             the APK installs but never appears in Settings → Tool Preferences /
             Plugins and cannot be loaded. Matches ATAK-CIV 5.8 SDK samples. -->
        <activity
            android:name="com.atakmap.app.component"
            android:exported="true"
            tools:ignore="MissingClass">
            <intent-filter android:label="@string/app_name">
                <action android:name="com.atakmap.app.component" />
            </intent-filter>
        </activity>

        <!-- Exported because plugin code runs in the ATAK host process and
             starts this service cross-package (see PlowTakShiftService). -->
        <service
            android:name="com.atakmap.android.plowtak.service.PlowTakShiftService"
            android:exported="true"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
