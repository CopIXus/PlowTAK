<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plowtak_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: title + Storm snowflake + Settings gear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/driver_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/plowtak_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/driver_storm_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/driver_storm_label"
                    android:src="@drawable/ic_plowtak_storm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/driver_storm_label"
                    android:textColor="@color/plowtak_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/driver_settings_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/driver_settings_label"
                    android:src="@drawable/ic_plowtak_settings" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/driver_settings_label"
                    android:textColor="@color/plowtak_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/driver_status_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/plowtak_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/driver_paint_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/plowtak_grey"
            android:textSize="13sp" />

        <!-- Shift login -->
        <LinearLayout
            android:id="@+id/driver_shift_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/driver_operator_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/driver_operator_name_hint"
                android:inputType="textPersonName"
                android:textColor="@color/plowtak_text"
                android:textColorHint="@color/plowtak_grey"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/driver_operator_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/driver_operator_id_hint"
                android:inputType="text"
                android:textColor="@color/plowtak_text"
                android:textColorHint="@color/plowtak_grey"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/driver_shift_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/plowtak_accent"
            android:text="@string/driver_shift_start"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Front-view plow + wings -->
        <com.atakmap.android.plowtak.ui.PlowControlView
            android:id="@+id/driver_plow_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="120dp" />

        <!-- Spread toggle -->
        <ToggleButton
            android:id="@+id/driver_spread_toggle"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/plowtak_toggle_off"
            android:drawableTop="@drawable/ic_ops_spreading"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/plowtak_text"
            android:textOff="@string/driver_spread_off"
            android:textOn="@string/driver_spread_on"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Pending supervisor task -->
        <LinearLayout
            android:id="@+id/driver_task_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/plowtak_toggle_off"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/driver_task_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/plowtak_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/driver_task_ack"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/plowtak_accent"
                    android:text="@string/driver_task_ack"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/driver_task_decline"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/plowtak_distress"
                    android:text="@string/driver_task_decline"
                    android:textColor="@color/plowtak_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/driver_material_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/driver_material_title"
            android:textColor="@color/plowtak_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/driver_material_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3" />

        <GridLayout
            android:id="@+id/driver_status_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/driver_hazards_title"
            android:textColor="@color/plowtak_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/driver_hazard_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/driver_conditions_title"
            android:textColor="@color/plowtak_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/driver_condition_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3" />

        <Button
            android:id="@+id/driver_distress"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/plowtak_distress"
            android:drawableTop="@drawable/ic_ops_mayday"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/driver_distress"
            android:textColor="@color/plowtak_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ToggleButton
            android:id="@+id/driver_night_toggle"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/plowtak_toggle_off"
            android:drawableTop="@drawable/ic_ops_night_off"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/plowtak_text"
            android:textOff="@string/driver_night_off"
            android:textOn="@string/driver_night_on"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
