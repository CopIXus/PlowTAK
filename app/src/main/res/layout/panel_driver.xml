<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ideaplow_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/driver_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ideaplow_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/driver_status_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ideaplow_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Shift login -->
        <LinearLayout
            android:id="@+id/driver_shift_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/driver_operator_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/driver_operator_name_hint"
                android:inputType="textPersonName"
                android:textColor="@color/ideaplow_text"
                android:textColorHint="@color/ideaplow_grey"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/driver_operator_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/driver_operator_id_hint"
                android:inputType="text"
                android:textColor="@color/ideaplow_text"
                android:textColorHint="@color/ideaplow_grey"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/driver_shift_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/ideaplow_accent"
            android:text="@string/driver_shift_start"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Glove-friendly equipment toggles -->
        <ToggleButton
            android:id="@+id/driver_blade_toggle"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/ideaplow_toggle_off"
            android:textColor="@color/ideaplow_text"
            android:textOff="@string/driver_blade_up"
            android:textOn="@string/driver_blade_down"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ToggleButton
            android:id="@+id/driver_salt_toggle"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/ideaplow_toggle_off"
            android:textColor="@color/ideaplow_text"
            android:textOff="@string/driver_salt_off"
            android:textOn="@string/driver_salt_on"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Pending supervisor task: big Ack / Decline -->
        <LinearLayout
            android:id="@+id/driver_task_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/ideaplow_toggle_off"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/driver_task_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ideaplow_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/driver_task_ack"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/ideaplow_accent"
                    android:text="@string/driver_task_ack"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/driver_task_decline"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/ideaplow_distress"
                    android:text="@string/driver_task_decline"
                    android:textColor="@color/ideaplow_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Material selector (spreader-equipped units) -->
        <TextView
            android:id="@+id/driver_material_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/driver_material_title"
            android:textColor="@color/ideaplow_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/driver_material_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4" />

        <!-- Width presets (wing / tow) -->
        <TextView
            android:id="@+id/driver_width_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/driver_width_title"
            android:textColor="@color/ideaplow_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/driver_width_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3" />

        <!-- One-tap statuses -->
        <GridLayout
            android:id="@+id/driver_status_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2" />

        <!-- Hazard drops -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/driver_hazards_title"
            android:textColor="@color/ideaplow_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/driver_hazard_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2" />

        <!-- Road condition quick report -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/driver_conditions_title"
            android:textColor="@color/ideaplow_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/driver_condition_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3" />

        <!-- Distress -->
        <Button
            android:id="@+id/driver_distress"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/ideaplow_distress"
            android:text="@string/driver_distress"
            android:textColor="@color/ideaplow_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ToggleButton
            android:id="@+id/driver_night_toggle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/ideaplow_toggle_off"
            android:textColor="@color/ideaplow_text"
            android:textOff="@string/driver_night_off"
            android:textOn="@string/driver_night_on"
            android:textSize="14sp" />

        <Button
            android:id="@+id/driver_settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/ideaplow_toggle_off"
            android:text="@string/driver_settings"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
