<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plowtak_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Header: title + Storm + Night + Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/driver_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/plowtak_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/driver_storm_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/driver_storm_label"
                    android:src="@drawable/ic_plowtak_storm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/driver_storm_label"
                    android:textColor="@color/plowtak_text"
                    android:textSize="9sp" />
            </LinearLayout>

            <ToggleButton
                android:id="@+id/driver_night_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/ic_ops_night_off"
                android:drawablePadding="0dp"
                android:gravity="center"
                android:paddingTop="2dp"
                android:textColor="@color/plowtak_text"
                android:textOff="@string/driver_night_short"
                android:textOn="@string/driver_night_short"
                android:textSize="9sp" />

            <LinearLayout
                android:id="@+id/driver_settings_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/driver_settings_label"
                    android:src="@drawable/ic_plowtak_settings" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/driver_settings_label"
                    android:textColor="@color/plowtak_text"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/driver_status_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/plowtak_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/driver_paint_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/plowtak_grey"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/driver_shift_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/driver_operator_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/driver_operator_name_hint"
                android:inputType="textPersonName"
                android:textColor="@color/plowtak_text"
                android:textColorHint="@color/plowtak_grey"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/driver_operator_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/driver_operator_id_hint"
                android:inputType="text"
                android:textColor="@color/plowtak_text"
                android:textColorHint="@color/plowtak_grey"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/driver_shift_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/plowtak_accent"
            android:text="@string/driver_shift_start"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.atakmap.android.plowtak.ui.PlowControlView
            android:id="@+id/driver_plow_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="120dp" />

        <LinearLayout
            android:id="@+id/driver_task_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/plowtak_tile"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/driver_task_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/plowtak_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/driver_task_ack"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/plowtak_accent"
                    android:text="@string/driver_task_ack"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/driver_task_decline"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/plowtak_distress"
                    android:text="@string/driver_task_decline"
                    android:textColor="@color/plowtak_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/driver_material_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/driver_material_title"
            android:textAllCaps="true"
            android:textColor="@color/plowtak_grey"
            android:textSize="11sp" />

        <com.atakmap.android.plowtak.ui.OpsTileGrid
            android:id="@+id/driver_material_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/driver_status_driving"
            android:textAllCaps="true"
            android:textColor="@color/plowtak_grey"
            android:textSize="11sp"
            android:visibility="gone" />

        <com.atakmap.android.plowtak.ui.OpsTileGrid
            android:id="@+id/driver_status_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/driver_hazards_title"
            android:textAllCaps="true"
            android:textColor="@color/plowtak_grey"
            android:textSize="11sp" />

        <com.atakmap.android.plowtak.ui.OpsTileGrid
            android:id="@+id/driver_hazard_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/driver_conditions_title"
            android:textAllCaps="true"
            android:textColor="@color/plowtak_grey"
            android:textSize="11sp" />

        <com.atakmap.android.plowtak.ui.OpsTileGrid
            android:id="@+id/driver_condition_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <Button
            android:id="@+id/driver_distress"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/plowtak_distress"
            android:drawableTop="@drawable/ic_ops_mayday"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/driver_distress"
            android:textColor="@color/plowtak_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
