<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plowtak_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/obs_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/obs_title"
        android:textColor="@color/plowtak_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/obs_storm_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/plowtak_accent"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/obs_alerts_title"
        android:textColor="@color/plowtak_red"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/obs_alert_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/obs_fleet_title"
        android:textColor="@color/plowtak_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/obs_fleet_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <Button
        android:id="@+id/obs_settings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/plowtak_toggle_off"
        android:text="@string/driver_settings"
        android:textSize="14sp" />
</LinearLayout>
