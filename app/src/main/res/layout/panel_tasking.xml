<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plowtak_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="96dp"
                android:text="@string/tasking_screen_title"
                android:textColor="@color/plowtak_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tasking_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tasking_hint"
                android:textColor="@color/plowtak_grey"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tasking_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/tasking_empty"
                android:textColor="@color/plowtak_accent"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/tasking_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/tasking_done"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_save_pill"
        android:elevation="8dp"
        android:minWidth="72dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/storm_done"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />
</FrameLayout>
