<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plowtak_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="96dp"
                android:text="@string/storm_screen_title"
                android:textColor="@color/plowtak_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/storm_status_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/plowtak_accent"
                android:textSize="15sp" />

            <!-- ============================== SERVER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:tag="plowtak_heading"
                android:text="@string/storm_section_server"
                android:textColor="@color/plowtak_heading"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/storm_server_spinner"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_field"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <!-- ============================== CHANNEL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:tag="plowtak_heading"
                android:text="@string/storm_section_channel"
                android:textColor="@color/plowtak_heading"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/storm_channel_spinner"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_field"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/storm_channel_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/plowtak_grey"
                android:textSize="12sp" />

            <!-- ============================== STORMS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:tag="plowtak_heading"
                android:text="@string/storm_section_storms"
                android:textColor="@color/plowtak_heading"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/storm_list_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/plowtak_grey"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/storm_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/storm_leave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/storm_leave"
                android:textSize="14sp" />

            <!-- ============================== CREATE NEW STORM (card) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="plowtak_heading"
                    android:text="@string/storm_section_new"
                    android:textColor="@color/plowtak_heading"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/storm_new_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field"
                    android:hint="@string/storm_new_name_hint"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/plowtak_text"
                    android:textColorHint="@color/plowtak_grey"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/storm_create"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_primary_button"
                    android:text="@string/storm_create"
                    android:textColor="@color/plowtak_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Floating done pill: fixed top-right, never scrolls away. -->
    <Button
        android:id="@+id/storm_done"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_save_pill"
        android:elevation="8dp"
        android:minWidth="72dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/storm_done"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />
</FrameLayout>
