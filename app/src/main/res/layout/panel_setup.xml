<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plowtak_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/setup_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="112dp"
            android:textColor="@color/plowtak_grey"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="112dp"
            android:text="@string/setup_title"
            android:textColor="@color/plowtak_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_intro"
            android:textColor="@color/plowtak_text"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/setup_type_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/setup_type_plow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:checked="true"
                android:text="@string/setup_type_plow"
                android:textColor="@color/plowtak_text"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/setup_type_salt"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/setup_type_salt"
                android:textColor="@color/plowtak_text"
                android:textSize="18sp" />
        </RadioGroup>

        <EditText
            android:id="@+id/setup_callsign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/setup_callsign_hint"
            android:inputType="text"
            android:textColor="@color/plowtak_text"
            android:textColorHint="@color/plowtak_grey"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/setup_vehicle_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setup_vehicle_id_hint"
            android:inputType="text"
            android:textColor="@color/plowtak_text"
            android:textColorHint="@color/plowtak_grey"
            android:textSize="18sp" />

        <!-- Plow / salt sub-options -->
        <LinearLayout
            android:id="@+id/setup_treat_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/setup_has_salt"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/setup_has_salt"
                android:textColor="@color/plowtak_text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setup_plow_width"
                android:textColor="@color/plowtak_heading"
                android:tag="plowtak_heading"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/setup_plow_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:hint="@string/setup_plow_width_hint"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/plowtak_text"
                android:textColorHint="@color/plowtak_grey"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/setup_wing_left_width"
                android:textColor="@color/plowtak_heading"
                android:tag="plowtak_heading"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/setup_wing_left_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:hint="@string/setup_wing_width_hint"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/plowtak_text"
                android:textColorHint="@color/plowtak_grey"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/setup_wing_right_width"
                android:textColor="@color/plowtak_heading"
                android:tag="plowtak_heading"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/setup_wing_right_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:hint="@string/setup_wing_width_hint"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/plowtak_text"
                android:textColorHint="@color/plowtak_grey"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/setup_tow_width"
                android:textColor="@color/plowtak_heading"
                android:tag="plowtak_heading"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/setup_tow_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:hint="@string/setup_tow_width_hint"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/plowtak_text"
                android:textColorHint="@color/plowtak_grey"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Observer sub-options -->
        <LinearLayout
            android:id="@+id/setup_observer_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/setup_observer_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_observer_label_hint"
                android:inputType="text"
                android:textColor="@color/plowtak_text"
                android:textColorHint="@color/plowtak_grey"
                android:textSize="16sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/setup_presence"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:checked="true"
            android:text="@string/setup_publish_presence"
            android:textColor="@color/plowtak_text"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/setup_distress"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:checked="true"
            android:text="@string/setup_distress_enabled"
            android:textColor="@color/plowtak_text"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/setup_tts"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:checked="true"
            android:text="@string/setup_tts_enabled"
            android:textColor="@color/plowtak_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_tasking_snooze_label"
            android:textColor="@color/plowtak_grey"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/setup_tasking_snooze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setup_tasking_snooze_hint"
            android:inputType="number"
            android:maxLines="1"
            android:textColor="@color/plowtak_text"
            android:textColorHint="@color/plowtak_grey"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/setup_map_hud"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:checked="true"
            android:text="@string/setup_map_hud_enabled"
            android:textColor="@color/plowtak_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:tag="plowtak_heading"
            android:text="@string/setup_condition_stale_label"
            android:textColor="@color/plowtak_heading"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/setup_condition_stale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_field"
            android:hint="@string/setup_condition_stale_hint"
            android:inputType="number"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/plowtak_text"
            android:textColorHint="@color/plowtak_grey"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/setup_roadsnap"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/setup_roadsnap_enabled"
            android:textColor="@color/plowtak_text"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/setup_roadsnap_dir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setup_roadsnap_dir_hint"
            android:inputType="text"
            android:textColor="@color/plowtak_text"
            android:textColorHint="@color/plowtak_grey"
            android:textSize="14sp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/setup_bt_enabled"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/setup_bt_enabled"
            android:textColor="@color/plowtak_text"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/setup_bt_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setup_bt_address_hint"
            android:inputType="text"
            android:textColor="@color/plowtak_text"
            android:textColorHint="@color/plowtak_grey"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/setup_bt_ble"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/setup_bt_ble"
            android:textColor="@color/plowtak_text"
            android:textSize="16sp" />

        <!-- Bottom spacer so the last controls clear the floating pill. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />
    </LinearLayout>
    </ScrollView>

    <!-- Floating save pill: fixed top-right, never scrolls away. -->
    <Button
        android:id="@+id/setup_save"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_save_pill"
        android:elevation="8dp"
        android:minWidth="72dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/setup_save"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />
</FrameLayout>
