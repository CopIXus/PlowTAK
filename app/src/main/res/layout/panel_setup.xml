<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ideaplow_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/ideaplow_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_intro"
            android:textColor="@color/ideaplow_text"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/setup_type_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/setup_type_plow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:checked="true"
                android:text="@string/setup_type_plow"
                android:textColor="@color/ideaplow_text"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/setup_type_salt"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/setup_type_salt"
                android:textColor="@color/ideaplow_text"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/setup_type_supervisor"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/setup_type_supervisor"
                android:textColor="@color/ideaplow_text"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/setup_type_observer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/setup_type_observer"
                android:textColor="@color/ideaplow_text"
                android:textSize="18sp" />
        </RadioGroup>

        <EditText
            android:id="@+id/setup_callsign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/setup_callsign_hint"
            android:inputType="text"
            android:textColor="@color/ideaplow_text"
            android:textColorHint="@color/ideaplow_grey"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/setup_vehicle_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setup_vehicle_id_hint"
            android:inputType="text"
            android:textColor="@color/ideaplow_text"
            android:textColorHint="@color/ideaplow_grey"
            android:textSize="18sp" />

        <!-- Plow / salt sub-options -->
        <LinearLayout
            android:id="@+id/setup_treat_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/setup_has_salt"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/setup_has_salt"
                android:textColor="@color/ideaplow_text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setup_plow_width"
                android:textColor="@color/ideaplow_text"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/setup_width_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setup_wing_width"
                android:textColor="@color/ideaplow_text"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/setup_wing_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setup_tow_width"
                android:textColor="@color/ideaplow_text"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/setup_tow_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- Observer sub-options -->
        <LinearLayout
            android:id="@+id/setup_observer_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/setup_observer_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_observer_label_hint"
                android:inputType="text"
                android:textColor="@color/ideaplow_text"
                android:textColorHint="@color/ideaplow_grey"
                android:textSize="16sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/setup_presence"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:checked="true"
            android:text="@string/setup_publish_presence"
            android:textColor="@color/ideaplow_text"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/setup_distress"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:checked="true"
            android:text="@string/setup_distress_enabled"
            android:textColor="@color/ideaplow_text"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/setup_tts"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:checked="true"
            android:text="@string/setup_tts_enabled"
            android:textColor="@color/ideaplow_text"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/setup_roadsnap"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/setup_roadsnap_enabled"
            android:textColor="@color/ideaplow_text"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/setup_roadsnap_dir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setup_roadsnap_dir_hint"
            android:inputType="text"
            android:textColor="@color/ideaplow_text"
            android:textColorHint="@color/ideaplow_grey"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/setup_bt_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.5"
            android:text="@string/setup_bluetooth_placeholder"
            android:textColor="@color/ideaplow_grey"
            android:textSize="14sp" />

        <Button
            android:id="@+id/setup_save"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/ideaplow_accent"
            android:text="@string/setup_save"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
